<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>خدمات SMMCPAN</title>
    <style>
      :root {
        --bg: #f4f7fb;
        --panel: #ffffff;
        --text: #162338;
        --muted: #58657d;
        --line: #e9edf5;
        --primary: #2f6df6;
        --primary-soft: #ebf2ff;
        --warning-bg: #fff7df;
        --warning-text: #8a5b00;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: Tahoma, Arial, sans-serif;
      }

      body {
        padding: 20px 16px 32px;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(22, 35, 56, 0.05);
        margin-bottom: 16px;
      }

      .tag {
        display: inline-block;
        background: var(--primary-soft);
        color: var(--primary);
        border-radius: 999px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0 0 10px;
        font-size: 28px;
      }

      p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .toolbar {
        display: flex;
        gap: 10px;
        margin-top: 18px;
      }

      button {
        appearance: none;
        border: none;
        border-radius: 12px;
        min-height: 46px;
        padding: 0 18px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 700;
        background: var(--primary);
        color: #fff;
      }

      button.secondary {
        background: #eef3ff;
        color: var(--primary);
      }

      .notice {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 13px;
        line-height: 1.6;
      }

      .services {
        margin-top: 16px;
      }

      .empty {
        padding: 24px 12px;
        text-align: center;
        color: var(--muted);
      }

      .service-card {
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 14px;
        background: #fff;
      }

      .service-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
      }

      .service-head h3 {
        margin: 0;
        font-size: 18px;
      }

      .badge {
        background: var(--primary-soft);
        color: var(--primary);
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 14px;
      }

      .meta {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 0;
        border-bottom: 1px solid var(--line);
        font-size: 14px;
      }

      .meta:last-child {
        border-bottom: none;
      }

      .meta span {
        color: var(--muted);
      }

      .meta strong {
        font-weight: 700;
      }

      @media (max-width: 520px) {
        .toolbar {
          display: block;
        }

        .toolbar button {
          width: 100%;
          margin-top: 10px;
        }

        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="panel">
        <span class="tag">SMMCPAN</span>
        <h1>الخدمات المتاحة</h1>
        <p>عرض خدمات SMMCPAN مباشرة من الخادم فقط، بدون إرسال مفتاح API إلى المتصفح أو Telegram.</p>
        <div class="toolbar">
          <button id="loadServices">تحميل الخدمات</button>
        </div>
        <div id="notice" class="notice" hidden></div>
      </div>

      <div class="panel">
        <div id="services" class="services empty">اضغط على زر «تحميل الخدمات» لعرض الخدمات.</div>
      </div>
    </main>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
      const list = document.getElementById('services');
      const notice = document.getElementById('notice');
      const loadButton = document.getElementById('loadServices');
      let allServices = [];

      const tg = window.Telegram && window.Telegram.WebApp;
      if (tg) {
        tg.ready();
        tg.expand();
      }

      function showNotice(message, isError = false) {
        if (!message) {
          notice.hidden = true;
          notice.textContent = '';
          return;
        }

        notice.hidden = false;
        notice.textContent = message;
        notice.style.background = isError ? '#fff1f1' : '#fff7df';
        notice.style.color = isError ? '#a12626' : '#8a5b00';
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[char]));
      }

      function formatNumber(value) {
        const number = Number(value || 0);
        return Number.isFinite(number) ? number.toLocaleString('ar-EG') : '0';
      }

      function renderServices() {
        if (!allServices.length) {
          list.className = 'services empty';
          list.textContent = 'لا توجد خدمات متاحة حاليًا.';
          return;
        }

        list.className = 'services';
        list.innerHTML = allServices.map((service) => `
          <article class="service-card">
            <div class="service-head">
              <h3>${escapeHtml(service.name)}</h3>
              <span class="badge">#${escapeHtml(service.service)}</span>
            </div>
            <div class="grid">
              <div class="meta"><span>التصنيف</span><strong>${escapeHtml(service.category)}</strong></div>
              <div class="meta"><span>السعر الأصلي</span><strong>${formatNumber(service.price)} ر.س</strong></div>
              <div class="meta"><span>الحد الأدنى</span><strong>${formatNumber(service.min)}</strong></div>
              <div class="meta"><span>الحد الأقصى</span><strong>${formatNumber(service.max)}</strong></div>
            </div>
          </article>
        `).join('');
      }

      async function loadServices() {
        list.className = 'services empty';
        list.textContent = 'جارٍ تحميل الخدمات...';
        showNotice('');

        try {
          const response = await fetch('/api/services');
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || 'تعذر تحميل الخدمات.');
          }

          allServices = Array.isArray(data.services) ? data.services : [];
          renderServices();
          showNotice(`تم تحميل ${allServices.length} خدمة بنجاح.`);
        } catch (error) {
          list.className = 'services empty';
          list.textContent = 'تعذر تحميل الخدمات.';
          showNotice(error.message || 'حدث خطأ أثناء الاتصال.', true);
        }
      }

      loadButton.addEventListener('click', loadServices);
    </script>
  </body>
</html>
